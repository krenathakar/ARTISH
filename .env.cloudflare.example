# =====================================================================
# CLOUDFLARE PAGES ENVIRONMENT VARIABLES (Server-side Secrets)
# Configure these in Cloudflare Dashboard:
# Workers & Pages -> artish-uk -> Settings -> Variables and Secrets
# (Never expose these in client/.env or frontend code!)
# =====================================================================

# Resend API Key from https://resend.com/api-keys (secret)
RESEND_API_KEY=re_your_api_key_here

# Consultation Lead Recipient Email
CONSULTATION_RECIPIENT_EMAIL=info@artishmedia.com

# Sender Address
# Before domain verification (test sandbox): Artish UK <onboarding@resend.dev>
# After artishmedia.com verification in Resend: Artish UK <consultations@artishmedia.com>
FROM_EMAIL=Artish UK <consultations@artishmedia.com>
